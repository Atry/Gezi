# The typed branch of the sum of the distinct subset sums: a call of the function a
# program writes by the definition equals the choice of itself and the typed version at a
# filtered operand, for every operand, by monotonicity alone, by the paper proof its
# declaration cites. That function is the IR term plover_money_sums itself, so no lemma
# folds it.
#
# The typed version is a noinline leaf, so the lemma never matches inside its own right
# side. Termination of this module's saturation, derived and not proved: the left sides'
# instances are the program's own subterms of those shapes, and the right sides add only
# an application of a term already there to the leaf, the typed leaf and a filter of an
# operand already there.
#
# FIXME (https://github.com/Atry/private-overlay/issues/2039): the recursion itself is left
# out of the leaves, unlike this family's other modules, as a workaround. The extraction
# prices a filtered list operand in full when it is a native's only operand, and a call of
# a leaf at about the operand alone, so with the recursion as a leaf the untyped call is
# the cheaper spelling and no block forms. When that issue closes, make it a leaf again.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ _ _ _ _ binary_set
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ true _ _ _
. omega (omega (omega (omega corpora "library") "native_types") "list")
λ _ _ _ list_type
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_money_sums")
λ plover_money_sums plover_typed_money_sums
. export
  ( λ _ rewriting _ _
    . rewriting
    λ _ _ leaves
    . leaves (λkey. key plover_typed_money_sums)
  + λ _ _ _ backend
    . backend
    λ _ natives _ _ _ _
    . natives (λ binding. binding plover_typed_money_sums λkey. key "plover_money_sums")
  + λ _ rewriting _ _
    . rewriting
    λ _ lemmas _
    . lemmas
      # A program binds the function once and calls it at each site. The let
      # is an instance of the β rule.
      ( λ lemma
        . lemma
          (λkey. key "plover_money_sums_let")
          (λ body. (λ function. body function) plover_money_sums)
          (λ body. body plover_money_sums)
        λ _ metadata _
        . metadata λkey. key "[plover_money_sums_let](docs/design/gezi-plover-ordered-compositions-proofs.md)"
      + λ lemma
        . lemma
          (λkey. key "plover_money_sums_branch")
          (λ coins. plover_money_sums coins)
          (λ coins. (plover_money_sums coins + plover_typed_money_sums (coins ∥ list_type (binary_set true))))
        λ _ metadata _
        . metadata λkey. key "[plover_money_sums_branch](docs/design/gezi-plover-ordered-compositions-proofs.md)"
      )
  )
