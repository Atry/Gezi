# hindley_milner_unions_judgments: the first part of the HM baseline, its leaves and
# its lemmas up to the application rule. hindley_milner_unions is this part,
# hindley_milner_unions_application and hindley_milner_unions_occurrences, in
# that order, the order its lemmas were written in one file;
# hindley_milner_unions_core is this part and hindley_milner_unions_occurrences.
#
# The lemmas of the HM baseline with unification as unions of classes: a type is a term of the ZERO UNIVERSE, built of the combinators
# of this module, each of which is top up to contextual equivalence, so that
# any two types are one term and an instance may unite any two type classes.
# A program node x is judged by its type, x + (x ∥ type_of x), sound by
# absorption; the constraints of HM between types are unify nodes, each top up
# to contextual equivalence and so equal to both its arguments
# (unions_unify_*), and decomposition makes the
# parts of two function types, two structures, two alternatives and two
# fields unified ones. No program node is spelled again, only terms of the
# zero universe.
#
# The types of data are STRUCTURES, with no name (`CONTRIBUTING.md`, "Structure only: no names, and every function a pure function of the term"): a Scott
# value's type is the field lists of its alternatives,
# structure (alternative f1 (alternative f2 ... no_alternative)), each fi a
# list field t (field u ... no_field). A constructor's scheme is the
# structure of its body, the i-th of n alternatives with its fields, the
# other alternatives' field lists scheme variables; constructors that share a
# body are one handle and have its one scheme, so that every occurrence
# instantiates it, whatever its type holds. A recursive type, the naturals'
# or the lists' in a fold's scheme, is recursive_type f, the zero-universe
# fixed point of the type function f, unfolded by
# unions_recursive_type_unfolding into a cycle of the graph: unification is
# the unification of rational trees, with no occurs check through a
# structure. Used with the library native_types.
#
# The typed versions and the contracts are in a backend's shape module,
# prolog_backend_shapes.pl for the Prolog backend.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "native_types") "natural")
λ zero successor nat_fold _
. omega (omega (omega (omega corpora "library") "hindley_milner_unions") "types")
λ function_type closure_type scheme zero_universe_scheme instance_variable
. omega (omega (omega (omega corpora "library") "hindley_milner_unions") "shapes")
λ structure alternative no_alternative field no_field recursive_type
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ _ false _ boolean_not
. omega (omega (omega (omega corpora "library") "native_types") "list")
λ _ cons list_fold _
. omega (omega (omega (omega corpora "library") "native_types") "combinators")
λ identity konstant compose
. omega (omega (omega (omega corpora "library") "native_types") "fixpoint")
λ fixpoint
. omega (omega (omega (omega corpora "library") "hindley_milner_unions") "judgments")
λ type_of candidate_of unify
. omega (omega (omega (omega corpora "library") "native_types") "markers")
λ _ _ $name $closure _
. omega (omega (omega (omega corpora "library") "native_types") "type_operators")
λ _ _ parameter
. export
  ( λ _ rewriting _ _
    . rewriting
    λ _ _ leaves
    . leaves
      ( λk. k closure_type
      + λk. k instance_variable
      + λk. k scheme
      + λk. k zero_universe_scheme
      + λk. k candidate_of
      + λk. k unify
      + λk. k recursive_type
      + λk. k no_field
      + λk. k field
      + λk. k no_alternative
      + λk. k alternative
      + λk. k structure
      + λk. k function_type
      + λk. k type_of
      )
  + λ _ rewriting _ _
    . rewriting
    λ _ lemmas _
    . lemmas
      # The unify node of two function types, two structures, two alternatives or
      # two fields is the choice of it and the unify nodes of their parts: all are
      # top up to contextual equivalence.
      ( λ s
        . s
          (λk. k "unions_field_decomposition")
          (λx_0 x_1 x_2 x_3. unify (field x_0 x_1) λ. field x_2 x_3)
          (λx_0 x_1 x_2 x_3. (unify x_1 x_3 + unify x_0 x_2 + unify (field x_0 x_1) λ. field x_2 x_3)) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_alternative_decomposition")
          (λx_0 x_1 x_2 x_3. unify (alternative x_0 x_1) λ. alternative x_2 x_3)
          ( λ x_0 x_1 x_2 x_3
            . (unify x_1 x_3 + unify x_0 x_2 + unify (alternative x_0 x_1) λ. alternative x_2 x_3)
          ) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_structure_decomposition")
          (λx_0 x_1. unify (structure x_0) λ. structure x_1)
          (λx_0 x_1. (unify x_0 x_1 + unify (structure x_0) λ. structure x_1)) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_function_decomposition")
          (λx_0 x_1 x_2 x_3. unify (function_type x_0 x_1) λ. function_type x_2 x_3)
          ( λ x_0 x_1 x_2 x_3
            . (unify x_1 x_3 + unify x_0 x_2 + unify (function_type x_0 x_1) λ. function_type x_2 x_3)
          ) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      # ---- unification ----
      # unify a b is a, and is b, for a and b of the zero universe: the three are
      # top up to contextual equivalence. One lemma for each kind of type the
      # argument is.
      + λ s
        . s
          (λk. k "unions_unify_variable_right")
          (λx_0 x_1 x_2. unify x_0 λ. instance_variable x_1 x_2)
          (λx_0 x_1 x_2. instance_variable x_1 x_2) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_variable_left")
          (λx_0 x_1 x_2. unify (instance_variable x_0 x_1) x_2)
          (λx_0 x_1 x_2. instance_variable x_0 x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_function_right")
          (λx_0 x_1 x_2. unify x_0 λ. function_type x_1 x_2)
          (λx_0 x_1 x_2. function_type x_1 x_2) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_function_left")
          (λx_0 x_1 x_2. unify (function_type x_0 x_1) x_2)
          (λx_0 x_1 x_2. function_type x_0 x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s (λk. k "unions_unify_no_field_right") (λx_0. unify x_0 no_field) (λx_0. no_field) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s (λk. k "unions_unify_no_field_left") (λx_0. unify no_field x_0) (λx_0. no_field) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_field_right")
          (λx_0 x_1 x_2. unify x_0 λ. field x_1 x_2)
          (λx_0 x_1 x_2. field x_1 x_2) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_field_left")
          (λx_0 x_1 x_2. unify (field x_0 x_1) x_2)
          (λx_0 x_1 x_2. field x_0 x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_no_alternative_right")
          (λx_0. unify x_0 no_alternative)
          (λx_0. no_alternative) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s (λk. k "unions_unify_no_alternative_left") (λx_0. unify no_alternative x_0) (λx_0. no_alternative) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_alternative_right")
          (λx_0 x_1 x_2. unify x_0 λ. alternative x_1 x_2)
          (λx_0 x_1 x_2. alternative x_1 x_2) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_alternative_left")
          (λx_0 x_1 x_2. unify (alternative x_0 x_1) x_2)
          (λx_0 x_1 x_2. alternative x_0 x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_structure_right")
          (λx_0 x_1. unify x_0 λ. structure x_1)
          (λx_0 x_1. structure x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s
          (λk. k "unions_unify_structure_left")
          (λx_0 x_1. unify (structure x_0) x_1)
          (λx_0 x_1. structure x_0) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s (λk. k "unions_unify_type_of_right") (λx_0 x_1. unify x_0 λ. type_of x_1) (λx_0 x_1. type_of x_1) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      + λ s
        . s (λk. k "unions_unify_type_of_left") (λx_0 x_1. unify (type_of x_0) x_1) (λx_0 x_1. type_of x_0) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      # ---- closures ----
      # parameter p is judged by p: absorption.
      + λ s
        . s
          (λk. k "unions_parameter_typed")
          (λx_0. parameter x_0)
          (λx_0. (parameter x_0 ∥ x_0 + parameter x_0)) λ_ md _. md λk. k "[absorption](docs/design/gezi-hindley-milner-unions-proofs.md#absorption)"
      # A closure c whose body m is a closure, a lambda chain of several
      # parameters: m is typed as a closure of its own, and c's type is unified
      # with function_type p (type_of m): all are top up to contextual equivalence.
      + λ s
        . s
          (λk. k "unions_closure_curried")
          (λx_0 x_1. closure_type x_0 λx_2. x_1 x_2)
          ( λ x_0 x_1
            . ( unify (type_of x_0) λ. function_type (instance_variable x_0 x_0) λ. type_of x_1
              + closure_type x_1 λ. x_1 λ. parameter λ. instance_variable x_1 x_1
              + closure_type x_0 λx_2. x_1 x_2
              )
          ) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      # A closure c whose body b is judged tb: the choice of closure_type c b and
      # the unify node of type_of c and function_type p tb, p the type of c's
      # parameter: all are top up to contextual equivalence.
      + λ s
        . s
          (λk. k "unions_closure_body")
          (λx_0 x_1 x_2. closure_type x_0 (x_1 ∥ x_2 + x_1))
          ( λ x_0 x_1 x_2
            . ( unify (type_of x_0) λ. function_type (instance_variable x_0 x_0) x_2
              + closure_type x_0 (x_1 ∥ x_2 + x_1)
              )
          ) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      # closure_type c b is type_of c: both are top up to contextual equivalence.
      + λ s
        . s (λk. k "unions_closure_type") (λx_0 x_1. closure_type x_0 x_1) (λx_0 x_1. type_of x_0) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      # A closure occurrence c is judged by closure_type c b, b its body read at
      # its parameter, parameter p, p the type variable named by c and c:
      # absorption. closure_type names the closure itself, not its type: the type
      # class of many closures is one class (all of the type nat_type -> nat_type
      # in successor ((\q. ...) p)), and a pattern binding c through it would
      # bind every closure of that type (measured 2026-10-28 on the nested family:
      # the matches of unions_closure_body grew as the square of the depth).
      + λ s
        . s
          (λk. k "unions_closure_typed")
          (λx_0 x_1. $closure x_0 λx_2. x_1 x_2)
          ( λ x_0 x_1
            . ( $closure x_0 λx_2. x_1 x_2
              ∥ λ
                . closure_type ($closure x_0 λx_2. x_1 x_2)
                λ
                . x_1 λ. parameter λ. instance_variable ($closure x_0 λx_2. x_1 x_2) λ. $closure x_0 λx_2. x_1 x_2
              + $closure x_0 λx_2. x_1 x_2
              )
          ) λ_ md _. md λk. k "[absorption](docs/design/gezi-hindley-milner-unions-proofs.md#absorption)"
      # ---- applications ----
      # [type_of x, unify a b] is type_of x: both members are top up to contextual
      # equivalence (top + M ≃_O M).
      + λ s
        . s
          (λk. k "unions_type_choice")
          (λx_0 x_1 x_2. (unify x_1 x_2 + type_of x_0))
          (λx_0 x_1 x_2. type_of x_0) λ_ md _. md λk. k "[zero_universe](docs/design/gezi-hindley-milner-unions-proofs.md#zero_universe)"
      )
  )
