# The typed branch of the total of the divisor sums modulo a modulus: a program that
# reduces the total, written by the definition, equals the choice of itself and the typed
# version at filtered operands, for all operands, by monotonicity alone, by the paper
# proof its declaration cites. The recursion a program writes is the IR term
# plover_total_of_divisor_sums itself, so no lemma folds it.
#
# The typed version is a noinline leaf, so the lemma never matches inside its own right
# side. Termination of this module's saturation, derived and not proved: the left sides'
# instances are the program's own subterms of those shapes, and the right sides add only
# applications of terms already there, the typed leaf and filters of operands already
# there.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ _ _ _ _ binary_set
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ true false _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_compositions")
λ _ _ plover_binary_modulo _ _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_divisor_sums")
λ plover_total_of_divisor_sums plover_typed_divisor_sums
. export
  ( λ _ rewriting _ _
    . rewriting
    λ _ _ leaves
    . leaves (λkey. key plover_total_of_divisor_sums + λkey. key plover_typed_divisor_sums)
  + λ _ _ _ backend
    . backend
    λ _ natives _ _ _ _
    . natives (λ binding. binding plover_typed_divisor_sums λkey. key "plover_divisor_sums")
  + λ _ rewriting _ _
    . rewriting
    λ _ lemmas _
    . lemmas
      # A program binds the function once and calls it at each site. Each of
      # the two is an instance of the β rule.
      ( λ lemma
        . lemma
          (λkey. key "plover_divisor_sums_let")
          ( λ body modulus
            . (λ function. body function) λ limit. plover_binary_modulo (plover_total_of_divisor_sums limit) modulus
          )
          (λ body modulus. body λ limit. plover_binary_modulo (plover_total_of_divisor_sums limit) modulus)
        λ _ metadata _
        . metadata λkey. key "[plover_divisor_sums_let](docs/design/gezi-plover-ordered-compositions-proofs.md)"
      + λ lemma
        . lemma
          (λkey. key "plover_divisor_sums_applied")
          ( λ modulus argument
            . (λ limit. plover_binary_modulo (plover_total_of_divisor_sums limit) modulus) argument
          )
          (λ modulus argument. plover_binary_modulo (plover_total_of_divisor_sums argument) modulus)
        λ _ metadata _
        . metadata λkey. key "[plover_divisor_sums_applied](docs/design/gezi-plover-ordered-compositions-proofs.md)"
      + λ lemma
        . lemma
          (λkey. key "plover_divisor_sums_branch")
          (λ limit modulus. plover_binary_modulo (plover_total_of_divisor_sums limit) modulus)
          ( λ limit modulus
            . ( plover_binary_modulo (plover_total_of_divisor_sums limit) modulus
              + plover_typed_divisor_sums (limit ∥ binary_set true) (modulus ∥ binary_set false)
              )
          )
        λ _ metadata _
        . metadata λkey. key "[plover_divisor_sums_branch](docs/design/gezi-plover-ordered-compositions-proofs.md)"
      )
  )
