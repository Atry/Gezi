# The Prolog backend's facts for fixed_width, a knowledge module of their own
# (one set of backend facts per backend; prolog_backend.pl has native_types',
# native_arithmetic_prolog_backend.pl native_arithmetic's): the words of
# word_type w are represented natively, each as one integer of w bits with its
# width (the family word, com.yang_bo.gezi.jit.WordFamily), and the two constructors
# the codec decodes into and encodes from are word_type's data_family, word_end
# at 0 and word_cell at 1, of no criterion parameter (the width is a value the
# family reads from the filter, not a criterion), and are leaves, so that no
# round unfolds them and the refinement keeps them as written. A filter
# `x ∥ word_type W`, W a numeral written out, in a term is then a decode point
# of the JIT, its width W read from that syntax. The data_family lists both
# constructors; which one a layer has is the width's (word_end at 0 alone,
# word_cell above), and the codec builds and takes each layer itself
# (NativeBackend.standard). Trusted,
# as every native specialization is; the family's law test
# (WordFamilyLawTest) checks that a layer taken and built again is the
# value, and the backend's check (BackendChecks) checks, when the library is
# compiled, the constructors' shape at the widths 0 and 1, which cover every
# width (WordFamily, THE SHAPE CHECK), and that each define takes one
# parameter for each of its constructor's fields. No lemma justifies these
# facts. Compiled with fixed_width and native_types.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "prelude") "list")
λ prelude_nil prelude_cons _ _ _
. omega (omega (omega (omega corpora "library") "integer") "cbor")
λ integer_from_cbor _
. (λtuple. tuple λ. integer_from_cbor λx. x)
λ integer_literal
. omega (omega (omega (omega corpora "library") "fixed_width") "word_representation")
λ word_end word_cell _ _ word_type _
. export
  ( λ _ _ _ backend
    . backend
    λ _ _ representations _ _ _
    . representations
    λ s
    . s word_type λk. k "word"
  + λ _ rewriting _ _
    . rewriting
    λ _ _ leaves
    . leaves
      ( λk. k word_cell
      + λk. k word_end
      )
  + λ _ _ _ backend
    . backend
    λ _ _ _ families _ _
    . families
    λ s
    . s word_type (integer_literal 0) λ. prelude_cons word_end λ. prelude_cons word_cell prelude_nil
  )
