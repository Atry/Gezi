# The sum of the distinct sums that nonempty sets of the coins make, written by the
# definition (the sum of every subset is built and inserted into an increasing list
# without repeats), and its typed version, which a native computes. The helpers have the
# structure problems/cses/money_sums gives them, so that plover_money_sums is the same IR
# term as the function a program writes.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "prelude") "fixpoint")
λ fixpoint
. omega (omega (omega (omega corpora "library") "prelude") "list")
λ nil cons append map _
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ binary_zero _ _ _ binary_set
. omega (omega (omega (omega corpora "library") "binary") "arithmetic")
λ _ merge_binary_plus _ merge_binary_equality
. omega (omega (omega (omega corpora "library") "binary") "order")
λ binary_less_than _ _
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ criterion_true _ _ _
. omega (omega (omega (omega corpora "library") "native_types") "list")
λ _ _ _ list_type
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self coins
    . coins nil
      λ coin others
      . ( λ without
          . cons coin λ. append without λ. map (λsum. merge_binary_plus sum coin) without
        ) λ. self others
  )
λ nonempty_sums
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self value sorted
    . sorted (cons value nil)
      λ head tail
      . binary_less_than value head (cons value sorted) (merge_binary_equality value head sorted (cons head λ. self value tail))
  )
λ insert
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self sums accumulated
    . sums accumulated
      λ sum others
      . self others (insert sum accumulated)
  )
λ sorted_distinct
# plover_money_sums:
# The function a program writes.
. ( λ tuple
    . tuple
    λ coins
    . fixpoint
      ( λ self total rest
        . rest total λ sum others. self (merge_binary_plus total sum) others
      ) binary_zero (sorted_distinct (nonempty_sums coins) nil)
  )
λ plover_money_sums
# plover_typed_money_sums:
# The coins a list of canonical naturals.
. (λtuple. tuple λ coins. (plover_money_sums (coins ∥ list_type (binary_set criterion_true)) ∥ binary_set criterion_true))
λ plover_typed_money_sums
. export plover_money_sums plover_typed_money_sums
