# The ordered compositions: the number of sequences of items that sum to target,
# modulo modulus, written by the definition, and its typed version, which a native
# computes.
#
# plover_concatenated_map, plover_count_from and plover_binary_modulo are spelled as the
# problems in problems/cses spell their own helpers, so that they are the same IR
# terms: a lemma's left side reaches a program's term only by its structure.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "prelude") "fixpoint")
λ fixpoint
. omega (omega (omega (omega corpora "library") "prelude") "boolean")
λ true false _ _
. omega (omega (omega (omega corpora "library") "prelude") "list")
λ nil cons append map _
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ binary_zero binary_even binary_odd _ binary_set
. omega (omega (omega (omega corpora "library") "binary") "arithmetic")
λ merge_binary_increment merge_binary_plus _ merge_binary_equality
. omega (omega (omega (omega corpora "library") "binary") "order")
λ binary_less_than _ _
. omega (omega (omega (omega corpora "library") "native_types") "list")
λ _ _ _ list_type
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ criterion_true criterion_false _ _
. ( λ tuple
    . tuple λ. fixpoint λself function items. items nil λhead tail. append (function head) λ. self function tail
  )
λ plover_concatenated_map
. ( λ tuple
    . tuple λ. fixpoint λself count items. items count λ_ tail. self (merge_binary_increment count) tail
  )
λ plover_count_from
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_binary_arithmetic")
λ binary_double binary_subtract
. (λtuple. tuple λdividend modulus. binary_less_than dividend modulus dividend (binary_subtract dividend modulus false))
λ binary_reduce
. ( λ tuple
    . tuple
    λ
    . fixpoint
    λ self number modulus
    . number binary_zero (λhalf. binary_reduce (binary_double (self half modulus)) modulus) λhalf. binary_reduce (binary_odd (self half modulus)) modulus
  )
λ plover_binary_modulo
# plover_sequences:
# Q of the proofs file, section 1: the list of the sequences of items summing
# to target. A noinline attractor: a lemma folds a program's own recursion into
# it, so that the count over it is one shape however the program lets it.
. ( λ tuple
    . tuple
    λ items target
    . fixpoint
      ( λ self partial_sum
        . binary_less_than target partial_sum nil λ. merge_binary_equality partial_sum target (cons nil nil) λ. plover_concatenated_map (λitem. map (cons item) λ. self λ. merge_binary_plus partial_sum item) items
      ) binary_zero
  )
λ plover_sequences
# plover_ordered_compositions:
# A of the proofs file, section 1.
. ( λ tuple
    . tuple λ items target modulus. plover_binary_modulo (plover_count_from binary_zero λ. plover_sequences items target) modulus
  )
λ plover_ordered_compositions
# plover_typed_ordered_compositions:
# A_T of the proofs file: the items positive canonical naturals, the target a
# canonical natural and the modulus a positive one.
. ( λ tuple
    . tuple
    λ items target modulus
    . (plover_ordered_compositions (items ∥ list_type (binary_set criterion_false)) (target ∥ binary_set criterion_true) (modulus ∥ binary_set criterion_false) ∥ binary_set criterion_true)
  )
λ plover_typed_ordered_compositions
. export plover_concatenated_map plover_count_from plover_binary_modulo plover_sequences plover_ordered_compositions plover_typed_ordered_compositions
