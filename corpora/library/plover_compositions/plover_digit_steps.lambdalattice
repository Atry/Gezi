# The fewest steps that take a natural to zero, a step subtracting one of its nonzero
# decimal digits, written by the definition, and its typed version, which a native
# computes. The helpers have the structure problems/cses/removing_digits and
# problems/cses/common/binary_modular give them, so that plover_digit_steps is the same
# IR term as the function a program writes, whatever the binders are called.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "prelude") "fixpoint")
λ fixpoint
. omega (omega (omega (omega corpora "library") "prelude") "boolean")
λ _ false _ _
. omega (omega (omega (omega corpora "library") "prelude") "list")
λ nil cons _ map _
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ binary_zero binary_even binary_odd _ binary_set
. omega (omega (omega (omega corpora "library") "binary") "arithmetic")
λ merge_binary_increment _ _ _
. omega (omega (omega (omega corpora "library") "binary") "order")
λ binary_less_than _ binary_minimum
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ criterion_true _ _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_binary_arithmetic")
λ binary_double binary_subtract
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_compositions")
λ plover_concatenated_map _ _ _ _ _
. (λtuple. tuple (binary_even λ. binary_odd λ. binary_even λ. binary_odd binary_zero))
λ ten
. ( λ tuple
    . tuple
    λ quotient remainder continue
    . binary_less_than remainder ten (continue (binary_double quotient) remainder) (continue (binary_odd quotient) (binary_subtract remainder ten false))
  )
λ settle
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self natural
    . natural (λcontinue. continue binary_zero binary_zero)
      (λhalf continue. self half λquotient remainder. settle quotient (binary_double remainder) continue)
      λhalf continue. self half λquotient remainder. settle quotient (binary_odd remainder) continue
  )
λ ten_quotient_remainder
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self number
    . number nil (λ_. ten_quotient_remainder number λquotient digit. cons digit λ. self quotient) λ_. ten_quotient_remainder number λquotient digit. cons digit λ. self quotient
  )
λ digits
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self number
    . ( λ step
        . number (cons binary_zero nil) (λ_. step) λ_. step
      )
      ( plover_concatenated_map
        ( λ digit
          . digit nil
            (λ_. map merge_binary_increment λ. self λ. binary_subtract number digit false)
            λ_. map merge_binary_increment λ. self λ. binary_subtract number digit false
        ) λ. digits number
      )
  )
λ step_lengths
. ( λ tuple
    . tuple λ. fixpoint λself least candidates. candidates least λcandidate rest. self (binary_minimum least candidate) rest
  )
λ fold_minimum
. (λtuple. tuple λnumber. step_lengths number binary_zero λhead tail. fold_minimum head tail)
λ plover_digit_steps
# plover_typed_digit_steps:
# T of the proofs file, section 8: the operand a canonical natural.
. (λtuple. tuple λ number. (plover_digit_steps (number ∥ binary_set criterion_true) ∥ binary_set criterion_true))
λ plover_typed_digit_steps
. export plover_digit_steps plover_typed_digit_steps
