# The fewest cuts that leave a rectangle in squares, written by the definition (a square
# needs none, and any other rectangle takes the least over every first cut across either
# side), and its typed version, which a native computes. The helpers have the structure
# problems/cses/rectangle_cutting gives them, so that plover_rectangle_cutting is the same
# IR term as the function a program writes.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "prelude") "fixpoint")
λ fixpoint
. omega (omega (omega (omega corpora "library") "prelude") "boolean")
λ _ false _ _
. omega (omega (omega (omega corpora "library") "prelude") "list")
λ nil cons append _ _
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ binary_zero _ binary_odd _ binary_set
. omega (omega (omega (omega corpora "library") "binary") "arithmetic")
λ merge_binary_increment merge_binary_plus _ merge_binary_equality
. omega (omega (omega (omega corpora "library") "binary") "order")
λ binary_less_than _ binary_minimum
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ criterion_true criterion_false _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_binary_arithmetic")
λ _ binary_subtract
. (λtuple. tuple (binary_odd binary_zero))
λ one
. ( λ tuple
    . tuple λ. fixpoint λself least candidates. candidates least λcandidate rest. self (binary_minimum least candidate) rest
  )
λ fold_minimum
. ( λ tuple
    . tuple
    λ cuts total other
    . fixpoint
      ( λ walk cut
        . binary_less_than cut total
          (cons (merge_binary_increment (merge_binary_plus (cuts cut other) (cuts (binary_subtract total cut false) other))) λ. walk (merge_binary_increment cut))
          nil
      ) one
  )
λ splits
. ( λ tuple
    . tuple
    λ. fixpoint
    λ self first_side second_side
    . merge_binary_equality first_side second_side binary_zero
      ( (append (splits self first_side second_side) λ. splits self second_side first_side)
        binary_zero λhead tail. fold_minimum head tail
      )
  )
λ rectangle_cuts
# plover_rectangle_cutting:
# The function a program writes, a noinline attractor.
. (λtuple. tuple λfirst_side second_side. rectangle_cuts first_side second_side)
λ plover_rectangle_cutting
# plover_typed_rectangle_cutting:
# Both sides positive canonical naturals.
. ( λ tuple
    . tuple
    λ first_side second_side
    . (plover_rectangle_cutting (first_side ∥ binary_set criterion_false) (second_side ∥ binary_set criterion_false) ∥ binary_set criterion_true)
  )
λ plover_typed_rectangle_cutting
. export plover_rectangle_cutting plover_typed_rectangle_cutting
