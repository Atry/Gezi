λ _ _ plover_binary_modulo _ _ _
# plover_power:
# P₃ of the proofs file, section 9. A noinline attractor.
. ( λ tuple
    . tuple
    λ
    . fixpoint
    λ self base exponent
    . exponent (binary_odd binary_zero) (λ_. merge_binary_times base λ. self base λ. binary_subtract exponent (binary_odd binary_zero) false) λ_. merge_binary_times base λ. self base λ. binary_subtract exponent (binary_odd binary_zero) false
