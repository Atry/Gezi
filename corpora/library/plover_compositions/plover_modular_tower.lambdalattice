# A natural to the power of a power, modulo a modulus, written by the definition with
# the recursion plover_power for both powers, and its typed version, which a native
# computes. The recursion has the structure problems/cses/exponentiation_two gives it.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "binary") "natural")
λ _ _ _ _ binary_set
. omega (omega (omega (omega corpora "library") "native_types") "boolean")
λ criterion_true criterion_false _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_compositions")
λ _ _ plover_binary_modulo _ _ _
. omega (omega (omega (omega corpora "library") "plover_compositions") "plover_modular_power")
λ plover_power _ _
# plover_modular_tower:
# base to the power (exponent_base to the power exponent_power), modulo the modulus.
. (λtuple. tuple λ base exponent_base exponent_power modulus. plover_binary_modulo (plover_power base (plover_power exponent_base exponent_power)) modulus)
λ plover_modular_tower
# plover_typed_modular_tower:
# The three numbers canonical naturals and the modulus a positive one.
. ( λ tuple
    . tuple
    λ base exponent_base exponent_power modulus
    . (plover_modular_tower (base ∥ binary_set criterion_true) (exponent_base ∥ binary_set criterion_true) (exponent_power ∥ binary_set criterion_true) (modulus ∥ binary_set criterion_false) ∥ binary_set criterion_true)
  )
λ plover_typed_modular_tower
. export plover_modular_tower plover_typed_modular_tower
