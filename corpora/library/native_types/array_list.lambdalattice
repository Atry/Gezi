# The array lists: the lists of element criterion e, under a criterion of their own so that
# a backend may hold them as one array whose every suffix shares it, rather than cell by
# cell. array_list e is list_type e under the synthetic label $array, the identity the
# label's partial function applied to its key is, the two equal by the β rule (docs/design/gezi-set-equations-proofs.md, section 24).
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega corpora "library") "native_types") "list")
λ _ _ _ list_type
. (λtuple. tuple λe. (λ"$array" v. v) "$array" (list_type e))
λ array_list
. export array_list
