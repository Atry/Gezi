  ( λ _capture_trap
    . _capture_trap (text "hidden_capture_times_plus_sixty_four_three") (boolean true)
    λ
    . text "times 64 3 with a plus that answers zero doubles six times (64 = even^6 (odd zero)) and on the odd bit answers plus 3 (...) = zero; double of zero is zero, so the product is zero and the test true"
  )
λ
. cons
  ( λ _capture_trap
    . _capture_trap (text "hidden_capture_times_plus_one_thousand_twenty_four_five") (boolean true)
    λ
