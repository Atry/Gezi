#   The index, the layer count and the stream's period of the main points.
#
# Each text is from_cbor of a string literal, a Scott list of bytes,
# imported from corpora/library/text/cbor. Each number is from_cbor of an
# integer literal, a Scott integer, imported from corpora/library/integer/cbor.
# FIXME: the imports project "corpora" https://github.com/Atry/private-overlay/issues/1923
# off the variable gezi, the name of the project root's own
# directory; it breaks if that directory is renamed.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "list")
λ nil cons _ _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "text") "cbor")
λ text_from_cbor _ _ _
. (λtuple. tuple λ. text_from_cbor λx. x)
λ text
. omega (omega (omega (omega (omega gezi "corpora") "library") "integer") "cbor")
λ integer_from_cbor _
. (λtuple. tuple λ. integer_from_cbor λx. x)
λ integer
. export
λ
. cons (λ_size. _size (text "index") λ. integer 300)
λ
. cons (λ_size. _size (text "layers") λ. integer 300)
λ
. cons (λ_size. _size (text "period") λ. integer 302) nil
