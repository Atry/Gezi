# the degree and the number of back edges (decimal texts), trap_cycles and
# trap_ladder. Read by its position
# (com.yang_bo.gezi.contest.corpora.reductions.Hidden37Courses, shape, into
# Hidden37Courses.CourseShape).
λ export
. export
  (λchain diamonds random trap_cycles trap_ladder. chain)
  (λchain diamonds random trap_cycles trap_ladder. diamonds)
  (λdegree back_edges chain diamonds random trap_cycles trap_ladder. random degree back_edges)
  (λchain diamonds random trap_cycles trap_ladder. trap_cycles) λchain diamonds random trap_cycles trap_ladder. trap_ladder
