#
# library_module(?Library, ?Module): the library's name, a text for the
# host, which looks a library up by it, and its module, the hierarchy row
# itself (a file of mixin_library/hierarchies, imported by omega). Each text is
# from_cbor of a string literal, a Scott list of bytes, imported from
# corpora/library/text/cbor.
# FIXME: the import projects "corpora" https://github.com/Atry/private-overlay/issues/1923
# off the variable gezi, the name of the project root's own
# directory; it breaks if that directory is renamed.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "list")
λ nil cons _ _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "text") "cbor")
λ text_from_cbor _ _ _
. (λtuple. tuple λ. text_from_cbor λx. x)
λ text
. omega (omega (omega (omega (omega gezi "problems") "mixin_library") "hierarchies") "natural_module")
λ hierarchy_natural_module
. omega (omega (omega (omega (omega gezi "problems") "mixin_library") "hierarchies") "binary_module")
λ hierarchy_binary_module
. export
λ
. cons (λ_library_module. _library_module (text "natural") hierarchy_natural_module)
λ
. cons (λ_library_module. _library_module (text "binary") hierarchy_binary_module) nil
