# The graph of a miss of miss_point: a Scott sum of eight constructors, in
# order: a ring, whose one field is its size; the graph with the target
# isolated, whose one field is the inner graph; then direct_first, diamond,
# two_rings, chord_ring, lasso and double_successor_ring, the graphs of
# contest_mixin_claims of those names. Read by its position
# (gezi.contest.corpora.merges.MixinTraps, graphName).
λ export
. export
  (λsize ring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. ring size)
  ( λ graph ring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring
    . isolated graph
  )
  (λring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. direct_first)
  (λring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. diamond)
  (λring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. two_rings)
  (λring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. chord_ring)
  (λring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring. lasso)
λ ring isolated direct_first diamond two_rings chord_ring lasso double_successor_ring
. double_successor_ring
