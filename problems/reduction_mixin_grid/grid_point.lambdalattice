λ
. cons (λ_grid_point. _grid_point (text "reduction_mixin_grid_paths_five") (integer 5) λ. integer 252)
λ
. cons (λ_grid_point. _grid_point (text "reduction_mixin_grid_paths_six") (integer 6) λ. integer 924)
λ
