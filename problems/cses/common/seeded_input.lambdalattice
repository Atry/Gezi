λ fixpoint
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "boolean")
λ true false _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "list")
λ nil cons _ _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "pair")
λ pair _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "binary") "natural")
λ binary_zero binary_even binary_odd _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "binary") "arithmetic")
λ merge_binary_increment merge_binary_plus merge_binary_times merge_binary_equality
. omega (omega (omega (omega (omega gezi "corpora") "library") "binary") "order")
λ binary_less_than binary_maximum binary_minimum
. omega (omega (omega (omega (omega gezi "problems") "cses") "common") "binary_modular")
λ _ binary_subtract _ binary_modulo
. (λtuple. tuple (binary_odd binary_zero))
λ one
. (λtuple. tuple (binary_even one))
λ two
. ( λ tuple
    . tuple λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_even λ. binary_even λ. binary_even λ. binary_odd λ. binary_even λ. binary_even λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_even λ. binary_odd binary_zero
  )
λ multiplier
. ( λ tuple
    . tuple λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd λ. binary_odd binary_zero
  )
λ modulus
. (λtuple. tuple λstate. binary_modulo (merge_binary_times multiplier state) modulus)
λ next_state
# draw state low high k: k applied to the next draw from [low, high] and the
# state it leaves.
. ( λ tuple
    . tuple λstate low high k. (λnext. k (merge_binary_plus low (binary_modulo next (merge_binary_increment (binary_subtract high low false)))) next) (next_state state)
  )
λ draw
# decremented counter: counter - 1, for counter >= 1.
. (λtuple. tuple λcounter. binary_subtract counter one false)
λ decremented
# counted f seed count: the list of count items, f state k giving k the item
# and the state it leaves, the first from seed.
. ( λ tuple
    . tuple λf. fixpoint λself state remaining. (λstep. remaining nil (λ_. step) λ_. step) (f state λitem next. cons item (self next (decremented remaining)))
  )
λ counted
. (λtuple. tuple λseed count low high. counted (λstate k. draw state low high k) seed count)
λ seeded_numbers
. (λtuple. tuple λseed count low high. counted (λstate k. draw state low high λx s1. draw s1 low high λy s2. k (pair x y) s2) seed count)
λ seeded_pairs
. ( λ tuple
    . tuple λseed count low high cost_low cost_high. counted (λstate k. draw state low high λx s1. draw s1 low high λy s2. draw s2 cost_low cost_high λc s3. k (pair x (pair y c)) s3) seed count
  )
λ seeded_triples
# row state columns odds k: k applied to a row of columns squares and the state
# it leaves.
. ( λ tuple
    . tuple λodds. fixpoint λself state remaining k. (λstep. remaining (k nil state) (λ_. step) λ_. step) (draw state one odds λd s1. self s1 (decremented remaining) λrest s2. k (cons (merge_binary_equality d one false true) rest) s2)
  )
λ row
. (λtuple. tuple λseed rows columns odds. counted (λstate k. row odds state columns k) seed rows)
λ seeded_grid
. (λtuple. tuple λgrid. grid nil λfirst_row rest. cons (first_row nil λ_ squares. cons false squares) rest)
λ trapped_first
# last_trapped items: the list with its last item false.
. (λtuple. tuple λ. fixpoint λself items. items nil λitem rest. rest (cons false nil) λ_ _. cons item (self rest))
λ last_trapped
. (λtuple. tuple λ. fixpoint λself rows. rows nil λlast_row rest. rest (cons (last_trapped last_row) nil) λ_ _. cons last_row (self rest))
λ trapped_last
. ( λ tuple
    . tuple λseed count n. counted (λstate k. draw state one n λa s1. draw s1 one (decremented n) λd s2. k (pair a (merge_binary_increment (binary_modulo (merge_binary_plus (decremented a) d) n))) s2) seed count
  )
λ seeded_connections
. ( λ tuple
    . tuple λseed n cost_low cost_high. fixpoint (λself state k. binary_less_than n k nil λ. draw state one (decremented k) λp s1. draw s1 cost_low cost_high λc s2. cons (pair p (pair k c)) (self s2 (merge_binary_increment k))) seed two
  )
λ seeded_tree
. ( λ tuple
    . tuple λseed count high. counted (λstate k. draw state binary_zero high λx s1. draw s1 binary_zero high λy s2. k (pair (binary_maximum x y) (binary_minimum x y)) s2) seed count
  )
λ seeded_binomial_queries
. export next_state seeded_numbers seeded_pairs seeded_triples seeded_grid trapped_first trapped_last seeded_connections seeded_tree seeded_binomial_queries
