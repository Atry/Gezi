. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega (omega gezi "corpora") "library") "native_types") "natural")
λ zero successor nat_fold _
. omega (omega (omega (omega (omega gezi "corpora") "library") "native_types") "list")
λ nil cons list_fold _
. omega (omega (omega (omega (omega gezi "corpora") "library") "native_types") "boolean")
λ true false _ boolean_not
. omega (omega (omega (omega (omega gezi "corpora") "library") "native_types") "combinators")
λ identity konstant compose
. omega (omega (omega (omega (omega gezi "corpora") "library") "native_types") "fixpoint")
