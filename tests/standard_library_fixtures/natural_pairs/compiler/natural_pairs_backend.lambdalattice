# A test-only knowledge file for a set of natives an entry adds to the
# standard set: pairs of naturals as one data family, natural_pair, whose
# codec encodes with the native bound to pair. The natives natural_pair_make
# and natural_pair_swap are no natives of the standard set; the test gives
# them (NativeBackendExtensionTest). The pair's fields are naturals of the
# standard set's big_integer, whose codec's constructors nat_type's data
# family gives. The file is not named natural_pairs: its own name would
# shadow the fixture's directory, the binder its imports read.
λ export
. (λtuple. tuple λmixin. mixin mixin)
λ omega
. omega (omega (omega (omega (omega gezi "corpora") "library") "prelude") "list")
λ nil cons _ _ _
. omega (omega (omega (omega (omega gezi "corpora") "library") "integer") "cbor")
λ integer_from_cbor _
. (λtuple. tuple λ. integer_from_cbor λx. x)
λ integer_literal
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "pair")
λ pair
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "swap")
λ swap
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "nat_type")
λ nat_type
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "natural_pair_type")
λ natural_pair_type
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "zero")
λ zero
. omega (omega (omega (omega natural_pairs "library") "natural_pairs") "successor")
λ successor
. export
  ( λ _ _ _ backend
    . backend
    λ _ _ _ _ fields _
    . fields
    λ s
    . s nat_type successor λ. cons (λ_ recursive _. recursive) nil
  + λ _ _ _ backend
    . backend
    λ _ _ _ families _ _
    . families
    λ s
    . s nat_type (integer_literal 0) λ. cons zero λ. cons successor nil
  + λ _ _ _ backend
    . backend
    λ _ _ representations _ _ _
    . representations
      ( λs. s natural_pair_type λk. k "natural_pair"
      + λs. s nat_type λk. k "big_integer"
      )
  + λ _ _ _ backend
    . backend
    λ _ natives _ _ _ _
    . natives
      ( λs. s swap λk. k "natural_pair_swap"
      + λs. s pair λk. k "natural_pair_make"
      )
  )
