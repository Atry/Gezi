def twiceClosureBetaText : String :=
  String.join (twiceClosureBetaLines.map (· ++ "\n"))

/-- The equation input = output that the article exports. -/
def twiceClosureBetaEquation : Article.Term × Article.Term :=
  exportedEquation (Article.readArticle twiceClosureBetaText)

/-- The signature of the article's thunk constants, read from its definitions. -/
def twiceClosureBetaSignature : Signature :=
  articleSignature (Article.readArticle twiceClosureBetaText)

open LambdaJit.Exported in
/-- The statements of the lemmas the article imports, in the order of the index. -/
def twiceClosureBetaLemmas : List EndToEnd.Statement :=
  [Statement.«closure_applied»]

open LambdaJit.Exported in
/-- Every lemma statement the article imports is sound, by its soundness declaration. -/
theorem twiceClosureBetaLemmasSound :
    ∀ lemma ∈ twiceClosureBetaLemmas, lemma.Sound :=
  soundCons «closure_applied» soundNil

set_option maxHeartbeats 300000 in
/-- No line of the article holds a newline, and `checkedReadAndEncoded` accepts the reading of its
lines with the lemma statements above and the run's input and output. The kernel evaluates it. -/
theorem twiceClosureBetaLinesChecked :
    (ArticleLines.linesClean twiceClosureBetaLines &&
      checkedReadAndEncoded twiceClosureBetaLemmas
        FixpointRunSides.twiceClosureBetaInput
        FixpointRunSides.twiceClosureBetaOutput
        (Article.readLines twiceClosureBetaLines)) = true := by
  decide +kernel

/-- The reader reads the article's text as it reads its lines. -/
theorem twiceClosureBetaRead :
    Article.readArticle twiceClosureBetaText =
      Article.readLines twiceClosureBetaLines := by
  have verified := twiceClosureBetaLinesChecked
  simp only [Bool.and_eq_true] at verified
  exact ArticleLines.readArticleOfLines verified.1

/-- `checkedReadAndEncoded` accepts the reading of the article's text. -/
theorem twiceClosureBetaCheckedReadAndEncoded :
    checkedReadAndEncoded twiceClosureBetaLemmas
      FixpointRunSides.twiceClosureBetaInput
      FixpointRunSides.twiceClosureBetaOutput
      (Article.readArticle twiceClosureBetaText) = true := by
  have verified := twiceClosureBetaLinesChecked
  simp only [Bool.and_eq_true] at verified
  rw [twiceClosureBetaRead]
  exact verified.2

/-- `checkedAndRead` accepts the reading of the article's text. -/
theorem twiceClosureBetaCheckedAndRead :
    checkedAndRead twiceClosureBetaLemmas
      (Article.readArticle twiceClosureBetaText) = true := by
  have verified := twiceClosureBetaCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, Bool.and_eq_true] at verified
  exact verified.1

/-- The reader accepts the article, `importChecked` accepts its import set with the lemma
statements above, and its one exported equation is `twiceClosureBetaEquation`. -/
theorem twiceClosureBetaChecked :
    resultChecked twiceClosureBetaSignature twiceClosureBetaLemmas
      twiceClosureBetaEquation.1 twiceClosureBetaEquation.2
      (Article.readArticle twiceClosureBetaText) = true := by
  have verified := twiceClosureBetaCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.1.1

/-- The exported equation input = output is sound: its two sides are contextually equivalent
under every valuation. -/
theorem twiceClosureBetaSound :
    EquationSound twiceClosureBetaSignature twiceClosureBetaEquation.1 twiceClosureBetaEquation.2 :=
  endToEndOfChecked twiceClosureBetaLemmasSound twiceClosureBetaChecked

/-- The left side, the input, reads as a term of the calculus. -/
theorem twiceClosureBetaLeftRead :
    (read twiceClosureBetaSignature twiceClosureBetaEquation.1).isSome = true := by
  have verified := twiceClosureBetaCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.1.2

/-- The right side, the output, reads as a term of the calculus. -/
theorem twiceClosureBetaRightRead :
    (read twiceClosureBetaSignature twiceClosureBetaEquation.2).isSome = true := by
  have verified := twiceClosureBetaCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.2

/-- The left side is the encoding of the run's input. -/
theorem twiceClosureBetaInputEncoded :
    Encoding.encode twiceClosureBetaSignature FixpointRunSides.twiceClosureBetaInput =
      some twiceClosureBetaEquation.1 := by
  have verified := twiceClosureBetaCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.1.2

/-- The right side is the encoding of the run's output. -/
theorem twiceClosureBetaOutputEncoded :
    Encoding.encode twiceClosureBetaSignature FixpointRunSides.twiceClosureBetaOutput =
      some twiceClosureBetaEquation.2 := by
  have verified := twiceClosureBetaCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.2

/-- The readings of the input and of the output are contextually equivalent. -/
theorem twiceClosureBetaContextualEquivalence :
    ∃ leftTerm rightTerm, read twiceClosureBetaSignature twiceClosureBetaEquation.1 = some leftTerm ∧
      read twiceClosureBetaSignature twiceClosureBetaEquation.2 = some rightTerm ∧
      ContextualEquivalence leftTerm rightTerm := by
  obtain ⟨leftTerm, leftRead⟩ :=
    Option.isSome_iff_exists.mp twiceClosureBetaLeftRead
  obtain ⟨rightTerm, rightRead⟩ :=
    Option.isSome_iff_exists.mp twiceClosureBetaRightRead
  exact ⟨leftTerm, rightTerm, leftRead, rightRead,
    contextualEquivalenceOfRead twiceClosureBetaSound leftRead rightRead⟩

/-- The article's signature is well formed: its names are distinct and none of them an
operator's. -/
theorem twiceClosureBetaWellFormed : Encoding.signatureWellFormed twiceClosureBetaSignature = true := by
  have verified := twiceClosureBetaCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.1.1

/-- The readbacks of the run's input and of its output, IR terms, are defined and contextually
equivalent: readback input ≃_O readback output. -/
theorem twiceClosureBetaReadbacks :
    ∃ inputTerm outputTerm,
      Readback.readback FixpointRunSides.twiceClosureBetaInput = some inputTerm ∧
      Readback.readback FixpointRunSides.twiceClosureBetaOutput = some outputTerm ∧
      ContextualEquivalence inputTerm outputTerm :=
  Encoding.endToEndEncodedOfChecked twiceClosureBetaWellFormed twiceClosureBetaLemmasSound
    twiceClosureBetaChecked twiceClosureBetaInputEncoded
    twiceClosureBetaOutputEncoded twiceClosureBetaLeftRead
    twiceClosureBetaRightRead

end LambdaJit.FixpointRunFixtures
