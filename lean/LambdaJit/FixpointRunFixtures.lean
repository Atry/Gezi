import LambdaJit.Encoding
import LambdaJit.ArticleLines
import LambdaJit.ExpectedArticles
import LambdaJit.NativeRouteLibraryStatements
import LambdaJit.FixpointRunSides

/-!
# The end-to-end theorem on the articles of the fixpoint runs

Generated by `FixpointRunModules.fixturesText` of
`gezi/proofs/src/test/scala/gezi/proofs/FixpointRunModules.scala` from the expected
articles of the runs of `FixpointRunModules.runs` and the index of their library; not edited. The
test `OpentheoryArticleFixpointRunsTest.theRunsWriteTheirExpectedArticlesAndTheirLeanModules`
checks that regenerating this module gives it byte for byte. A run is one round of the baseline's
search strategy `fixpoint_egraph` on a program over the knowledge of
`gezi/tests/library_fixtures/prolog_backend_closure_application.lambdalattice`:
the native route's type check, or the beta rule on the program's closures. The writer
`gezi/proofs/src/main/scala/gezi/proofs/OpentheoryArticle.scala` writes its article
through the schedule's round with an article (`Round(Strategy, Some(File))` of
`gezi/strategies/src/main/scala/gezi/strategies/Schedule.scala`); the article exports
the one equation input = output and is kept as
`gezi/tests/opentheory_article_expected/<run>.art`, its lines in module `ExpectedArticles`.
For each article:

- `…Text`: its text, its lines each followed by a newline;
- `…Equation`: the one equation it exports, as the reader reads it;
- `…Lemmas`: the statements of the lemmas it imports, in the order of the index, from the export
  of the native route's library (module `NativeRouteLibraryStatements`), and `…LemmasSound`
  their soundness, by the soundness declarations of that module, each a theorem;
- `…LinesChecked`: no line holds a newline, the reader accepts the lines, every equation of the
  import set is a numbered equation, an equation of the defunctionalized β rule or η rule of a
  thunk constant, or one of those lemma statements, the article exports one equation, both of its
  sides have a reading (`checkedAndRead`), and its sides are the encodings of the run's input and
  output (`sidesEncoded`), the finite terms of module `FixpointRunSides`. The kernel evaluates it
  (`decide +kernel`), reading the article once (`checkedReadAndEncoded`); `…Checked`,
  `…LeftRead`, `…RightRead`, `…InputEncoded` and `…OutputEncoded` are its parts on the text,
  which the reader reads as it reads the lines (`ArticleLines.readArticleOfLines`);
- `…Sound`: the exported equation is sound (`EndToEnd.endToEndOfChecked`);
- `…ContextualEquivalence`: both sides read as terms of the calculus (`Interpretation.read`),
  and the two readings are contextually equivalent, ≃_O of DdLP96's Definition 14
  (`EndToEnd.contextualEquivalenceOfRead`);
- `…Readbacks`: the readbacks of the run's input and output are defined and contextually
  equivalent (`Encoding.endToEndEncodedOfChecked`).

Module `FixpointRunFixturesAxioms` prints the axioms of these theorems. They stop at the readbacks
of the run's IR terms: that the finite terms of module `FixpointRunSides` are those terms rests on
the Scala test that checks that module, and no module carries the theorem to the source
program (link (i) of D6).

Measured 2026-11-21 with Lean 4.35.0, in a cold `lake build` of the package on 4 CPUs (nice 10)
under a machine load of 8.3 to 13.3: this module took 216 s, and the largest resident set of the
build's processes, which GNU time reports, was 7.2 GB (7,220,524 kB). The kernel's check of an
article is most of it: built alone, each in a module of its own (4c3d7d0c9, reverted), the
articles of the markers' keys, before the markers' members took the `$` prefix, took 74 s and 8.0 GB (compose_redex_type_check), 59 s
and 6.9 GB (twice_closure_type_check) and 49 s and 5.1 GB (successor_zero_type_check). The
articles are of 4304 to 12682 lines of at most 41 characters.
-/

namespace LambdaJit.FixpointRunFixtures

open LambdaJit.EndToEnd LambdaJit.Interpretation LambdaJit.ExpectedArticles
open LambdaJit.ContextualPreorder (ContextualEquivalence)

/-- The one equation that a reading `result` of an article exports, or x = x, x a variable, when
the reader rejected the article or it exports another number of equations. -/
def exportedEquation : Except String Article.Theory → Article.Term × Article.Term
  | .ok theory =>
      match Article.importEquations theory.theorems with
      | [equation] => equation
      | _ => (.termVariable ⟨[], "x"⟩ termType, .termVariable ⟨[], "x"⟩ termType)
  | .error _ => (.termVariable ⟨[], "x"⟩ termType, .termVariable ⟨[], "x"⟩ termType)

/-- The signature of a reading `result` of an article, read from its definitions (D7.1), or the
empty signature when the reader rejected the article. -/
def articleSignature : Except String Article.Theory → Signature
  | .ok theory => signatureOf theory.definitions
  | .error _ => []

/-- Whether `resultChecked` accepts a reading `result` of an article with the equation it exports
under the article's signature, and both sides of that equation have a reading. -/
def checkedAndRead (lemmas : List EndToEnd.Statement)
    (result : Except String Article.Theory) : Bool :=
  resultChecked (articleSignature result) lemmas (exportedEquation result).1
      (exportedEquation result).2 result &&
    (read (articleSignature result) (exportedEquation result).1).isSome &&
      (read (articleSignature result) (exportedEquation result).2).isSome

/-- Whether the article's signature is well formed and the equation a reading `result` of the
article exports is the pair of the writer's encodings (`Encoding.encode`) of the finite terms
`input` and `output` under it. -/
def sidesEncoded (input output : FiniteTerm) (result : Except String Article.Theory) : Bool :=
  Encoding.signatureWellFormed (articleSignature result) &&
    Encoding.encode (articleSignature result) input == some (exportedEquation result).1 &&
      Encoding.encode (articleSignature result) output == some (exportedEquation result).2

/-- `checkedAndRead` and `sidesEncoded` of one reading: one Boolean, so that the kernel reads the
article once for all of them. -/
def checkedReadAndEncoded (lemmas : List EndToEnd.Statement) (input output : FiniteTerm)
    (result : Except String Article.Theory) : Bool :=
  checkedAndRead lemmas result && sidesEncoded input output result

/-! ## successor_zero_type_check

The program `successor@zero` (`successor_zero`) under the round `type_check`.
Its strategy takes the lemmas of the tests' round `prolog_backend_type_check`;
its article imports the statements of 14 of them. -/

/-- The text of `successor_zero_type_check.art`: its lines, each followed by a newline. -/
def successorZeroTypeCheckText : String :=
  String.join (successorZeroTypeCheckLines.map (· ++ "\n"))

/-- The equation input = output that the article exports. -/
def successorZeroTypeCheckEquation : Article.Term × Article.Term :=
  exportedEquation (Article.readArticle successorZeroTypeCheckText)

/-- The signature of the article's thunk constants, read from its definitions. -/
def successorZeroTypeCheckSignature : Signature :=
  articleSignature (Article.readArticle successorZeroTypeCheckText)

open LambdaJit.Exported in
/-- The statements of the lemmas the article imports, in the order of the index. -/
def successorZeroTypeCheckLemmas : List EndToEnd.Statement :=
  [Statement.«unions_absorption»,
   Statement.«unions_occurrence_typed»,
   Statement.«unions_type_choice»,
   Statement.«unions_unify_type_of_left»,
   Statement.«unions_unify_structure_right»,
   Statement.«unions_unify_no_alternative_right»,
   Statement.«unions_unify_no_field_right»,
   Statement.«unions_unify_function_right»,
   Statement.«unions_unify_variable_left»,
   Statement.«shapes_natural_candidate»,
   Statement.«shapes_unify_candidate_right»,
   Statement.«shapes_unify_item_candidate_right»,
   Statement.«shapes_function_candidate»,
   Statement.«shapes_typed_version_function»]

open LambdaJit.Exported in
/-- Every lemma statement the article imports is sound, by its soundness declaration. -/
theorem successorZeroTypeCheckLemmasSound :
    ∀ lemma ∈ successorZeroTypeCheckLemmas, lemma.Sound :=
  soundCons «unions_absorption» <|
  soundCons «unions_occurrence_typed» <|
  soundCons «unions_type_choice» <|
  soundCons «unions_unify_type_of_left» <|
  soundCons «unions_unify_structure_right» <|
  soundCons «unions_unify_no_alternative_right» <|
  soundCons «unions_unify_no_field_right» <|
  soundCons «unions_unify_function_right» <|
  soundCons «unions_unify_variable_left» <|
  soundCons «shapes_natural_candidate» <|
  soundCons «shapes_unify_candidate_right» <|
  soundCons «shapes_unify_item_candidate_right» <|
  soundCons «shapes_function_candidate» <|
  soundCons «shapes_typed_version_function» soundNil

set_option maxHeartbeats 300000 in
/-- No line of the article holds a newline, and `checkedReadAndEncoded` accepts the reading of its
lines with the lemma statements above and the run's input and output. The kernel evaluates it. -/
theorem successorZeroTypeCheckLinesChecked :
    (ArticleLines.linesClean successorZeroTypeCheckLines &&
      checkedReadAndEncoded successorZeroTypeCheckLemmas
        FixpointRunSides.successorZeroTypeCheckInput
        FixpointRunSides.successorZeroTypeCheckOutput
        (Article.readLines successorZeroTypeCheckLines)) = true := by
  decide +kernel

/-- The reader reads the article's text as it reads its lines. -/
theorem successorZeroTypeCheckRead :
    Article.readArticle successorZeroTypeCheckText =
      Article.readLines successorZeroTypeCheckLines := by
  have verified := successorZeroTypeCheckLinesChecked
  simp only [Bool.and_eq_true] at verified
  exact ArticleLines.readArticleOfLines verified.1

/-- `checkedReadAndEncoded` accepts the reading of the article's text. -/
theorem successorZeroTypeCheckCheckedReadAndEncoded :
    checkedReadAndEncoded successorZeroTypeCheckLemmas
      FixpointRunSides.successorZeroTypeCheckInput
      FixpointRunSides.successorZeroTypeCheckOutput
      (Article.readArticle successorZeroTypeCheckText) = true := by
  have verified := successorZeroTypeCheckLinesChecked
  simp only [Bool.and_eq_true] at verified
  rw [successorZeroTypeCheckRead]
  exact verified.2

/-- `checkedAndRead` accepts the reading of the article's text. -/
theorem successorZeroTypeCheckCheckedAndRead :
    checkedAndRead successorZeroTypeCheckLemmas
      (Article.readArticle successorZeroTypeCheckText) = true := by
  have verified := successorZeroTypeCheckCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, Bool.and_eq_true] at verified
  exact verified.1

/-- The reader accepts the article, `importChecked` accepts its import set with the lemma
statements above, and its one exported equation is `successorZeroTypeCheckEquation`. -/
theorem successorZeroTypeCheckChecked :
    resultChecked successorZeroTypeCheckSignature successorZeroTypeCheckLemmas
      successorZeroTypeCheckEquation.1 successorZeroTypeCheckEquation.2
      (Article.readArticle successorZeroTypeCheckText) = true := by
  have verified := successorZeroTypeCheckCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.1.1

/-- The exported equation input = output is sound: its two sides are contextually equivalent
under every valuation. -/
theorem successorZeroTypeCheckSound :
    EquationSound successorZeroTypeCheckSignature successorZeroTypeCheckEquation.1 successorZeroTypeCheckEquation.2 :=
  endToEndOfChecked successorZeroTypeCheckLemmasSound successorZeroTypeCheckChecked

/-- The left side, the input, reads as a term of the calculus. -/
theorem successorZeroTypeCheckLeftRead :
    (read successorZeroTypeCheckSignature successorZeroTypeCheckEquation.1).isSome = true := by
  have verified := successorZeroTypeCheckCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.1.2

/-- The right side, the output, reads as a term of the calculus. -/
theorem successorZeroTypeCheckRightRead :
    (read successorZeroTypeCheckSignature successorZeroTypeCheckEquation.2).isSome = true := by
  have verified := successorZeroTypeCheckCheckedAndRead
  simp only [checkedAndRead, Bool.and_eq_true] at verified
  exact verified.2

/-- The left side is the encoding of the run's input. -/
theorem successorZeroTypeCheckInputEncoded :
    Encoding.encode successorZeroTypeCheckSignature FixpointRunSides.successorZeroTypeCheckInput =
      some successorZeroTypeCheckEquation.1 := by
  have verified := successorZeroTypeCheckCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.1.2

/-- The right side is the encoding of the run's output. -/
theorem successorZeroTypeCheckOutputEncoded :
    Encoding.encode successorZeroTypeCheckSignature FixpointRunSides.successorZeroTypeCheckOutput =
      some successorZeroTypeCheckEquation.2 := by
  have verified := successorZeroTypeCheckCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.2

/-- The readings of the input and of the output are contextually equivalent. -/
theorem successorZeroTypeCheckContextualEquivalence :
    ∃ leftTerm rightTerm, read successorZeroTypeCheckSignature successorZeroTypeCheckEquation.1 = some leftTerm ∧
      read successorZeroTypeCheckSignature successorZeroTypeCheckEquation.2 = some rightTerm ∧
      ContextualEquivalence leftTerm rightTerm := by
  obtain ⟨leftTerm, leftRead⟩ :=
    Option.isSome_iff_exists.mp successorZeroTypeCheckLeftRead
  obtain ⟨rightTerm, rightRead⟩ :=
    Option.isSome_iff_exists.mp successorZeroTypeCheckRightRead
  exact ⟨leftTerm, rightTerm, leftRead, rightRead,
    contextualEquivalenceOfRead successorZeroTypeCheckSound leftRead rightRead⟩

/-- The article's signature is well formed: its names are distinct and none of them an
operator's. -/
theorem successorZeroTypeCheckWellFormed : Encoding.signatureWellFormed successorZeroTypeCheckSignature = true := by
  have verified := successorZeroTypeCheckCheckedReadAndEncoded
  simp only [checkedReadAndEncoded, sidesEncoded, Bool.and_eq_true, beq_iff_eq] at verified
  exact verified.2.1.1

/-- The readbacks of the run's input and of its output, IR terms, are defined and contextually
equivalent: readback input ≃_O readback output. -/
theorem successorZeroTypeCheckReadbacks :
    ∃ inputTerm outputTerm,
      Readback.readback FixpointRunSides.successorZeroTypeCheckInput = some inputTerm ∧
      Readback.readback FixpointRunSides.successorZeroTypeCheckOutput = some outputTerm ∧
      ContextualEquivalence inputTerm outputTerm :=
  Encoding.endToEndEncodedOfChecked successorZeroTypeCheckWellFormed successorZeroTypeCheckLemmasSound
    successorZeroTypeCheckChecked successorZeroTypeCheckInputEncoded
    successorZeroTypeCheckOutputEncoded successorZeroTypeCheckLeftRead
    successorZeroTypeCheckRightRead

