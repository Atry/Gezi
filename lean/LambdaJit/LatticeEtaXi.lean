import LambdaJit.LatticeEtaConsistency
import LambdaJit.ContextualPreorderUnconditional
import LambdaJit.ContextualPreorderApproximation
import LambdaJit.ContextualPreorderSeparationProof

/-!
# Ξ in ⊢_{λ-lattice-η}: bracket abstraction, theorem two and lemma (F)

The proofs file, section 3, proves that
Ξ = Y (λe. Ŝ ∥ (K ∥ e e)) (module `ContextualPreorderAdequacy`, `fixedPointOfXi`) refines every
closed term in ⊢_{λ-lattice-η}, the derivability with no unit law (module
`LatticeEtaDerivability`; the proofs file's ⊢_B of section 21). This module checks it:

- `derivableLatticeEtaShiftFrom`, `derivableLatticeEtaSubstitute`: ∅ ⊢_{λ-lattice-η} is closed under
  shifting and substitution.
- `xiUnfold`: Ξ = Ŝ ∥ (K ∥ Ξ Ξ) by the β rule, and so Ξ refines Ŝ, K and Ξ Ξ (step 1 of theorem two).
- `Combinatory`, `xiRefinesCombinatory`: the closed terms generated by Ŝ and K under application,
  ∥ and +, the proofs file's 𝒞, are refined by Ξ (step 2).
- `Combination`, `Combination.abstract`, `translate`: the bracket abstraction of step 3, on
  combinations of de Bruijn variables, Ŝ and K; `embedTranslate`: every term equals the embedding of
  its translation, and a closed one translates to a combination with no variable.
- `xiRefinesClosed`: the proofs file's theorem two, ⊢_{λ-lattice-η} Ξ + M = M for every closed M.
- `RefinesClosedTerms`, `refinesClosedTermsApplyAll`: lemma (F), Ξ A⃗ + M = M for every closed M and
  every list A⃗, in the form "Ξ A⃗ refines every closed term"; the property is kept by equality, by
  application to anything, by a parallel with anything and by a choice of two such terms.
- `inconsistentOfChoiceRefines`: if K + Z = Z is derivable from some hypotheses for a Z that
  refines every closed term, then K = K* is: the last step of section 21's separation, section
  14.3's argument with Z in the place of 0.
-/

namespace LambdaJit.LatticeEta

open LambdaJit.Semantics
open LambdaJit.Semantics.Term
open LambdaJit.ContextualPreorder

/-! ## Closure under shifting and substitution -/

/-- ∅ ⊢_{λ-lattice-η} M = N gives ∅ ⊢_{λ-lattice-η} M↑ = N↑ for every shift. -/
theorem derivableLatticeEtaShiftFrom {left right : Term}
    (derivation : DerivableLatticeEta (fun _ _ => False) left right) :
    ∀ cutoff, DerivableLatticeEta (fun _ _ => False) (shiftFrom cutoff left)
      (shiftFrom cutoff right) := by
  induction derivation with
  | hypothesis impossible => exact impossible.elim
  | symmetric _ inner => exact fun cutoff => .symmetric (inner cutoff)
  | transitive _ _ leftInner rightInner =>
      exact fun cutoff => .transitive (leftInner cutoff) (rightInner cutoff)
  | congruenceArgument function _ inner =>
      exact fun cutoff => .congruenceArgument _ (inner cutoff)
  | congruenceAbstraction _ inner =>
      exact fun cutoff => .congruenceAbstraction (inner (cutoff + 1))
  | beta body argument =>
      intro cutoff
      show DerivableLatticeEta _ (.application (.abstraction (shiftFrom (cutoff + 1) body))
        (shiftFrom cutoff argument)) _
      rw [BetaEtaConfluence.shiftFromInstantiate]
      exact .beta _ _
  | eta function =>
      intro cutoff
      show DerivableLatticeEta _ (.abstraction (.application (shiftFrom (cutoff + 1) (shift function))
        (shiftFrom (cutoff + 1) (.boundVariable 0)))) _
      rw [BetaEtaConfluence.shiftFromShifted]
      exact .eta _
  | choiceCommutative left right => exact fun _ => .choiceCommutative _ _
  | parallelCommutative left right => exact fun _ => .parallelCommutative _ _
  | parallelAbsorption kept other => exact fun _ => .parallelAbsorption _ _
  | argumentMonotone function argument addition => exact fun _ => .argumentMonotone _ _ _

/-- ∅ ⊢_{λ-lattice-η} M = N gives ∅ ⊢_{λ-lattice-η} M[d := R] = N[d := R]. -/
theorem derivableLatticeEtaSubstitute {left right : Term}
    (derivation : DerivableLatticeEta (fun _ _ => False) left right) :
    ∀ depth replacement, DerivableLatticeEta (fun _ _ => False) (substitute depth replacement left)
      (substitute depth replacement right) := by
  induction derivation with
  | hypothesis impossible => exact impossible.elim
  | symmetric _ inner => exact fun depth replacement => .symmetric (inner depth replacement)
  | transitive _ _ leftInner rightInner =>
      exact fun depth replacement =>
        .transitive (leftInner depth replacement) (rightInner depth replacement)
  | congruenceArgument function _ inner =>
      exact fun depth replacement => .congruenceArgument _ (inner depth replacement)
  | congruenceAbstraction _ inner =>
      exact fun depth replacement => .congruenceAbstraction (inner (depth + 1) (shift replacement))
  | beta body argument =>
      intro depth replacement
      show DerivableLatticeEta _ (.application
        (.abstraction (substitute (depth + 1) (shift replacement) body))
        (substitute depth replacement argument)) _
      rw [BetaEtaConfluence.substituteInstantiate]
      exact .beta _ _
  | eta function =>
      intro depth replacement
      show DerivableLatticeEta _ (.abstraction (.application
        (substitute (depth + 1) (shift replacement) (shift function))
        (substitute (depth + 1) (shift replacement) (.boundVariable 0)))) _
      rw [BetaEtaConfluence.substituteShifted]
      have variableKept : substitute (depth + 1) (shift replacement) (.boundVariable 0) =
          .boundVariable 0 := by simp [substitute]
      rw [variableKept]
      exact .eta _
  | choiceCommutative left right => exact fun _ _ => .choiceCommutative _ _
  | parallelCommutative left right => exact fun _ _ => .parallelCommutative _ _
  | parallelAbsorption kept other => exact fun _ _ => .parallelAbsorption _ _
  | argumentMonotone function argument addition => exact fun _ _ => .argumentMonotone _ _ _

/-! ## Equalities along spines -/

/-- The congruence in the head of a spine: M P⃗ = N P⃗ from M = N. -/
theorem congruenceApplyAll {hypotheses : Term → Term → Prop} :
    ∀ (arguments : List Term) {before after : Term},
      DerivableLatticeEta hypotheses before after →
        DerivableLatticeEta hypotheses (applyAll before arguments) (applyAll after arguments)
  | [], _, _, equal => equal
  | argument :: rest, _, _, equal => congruenceApplyAll rest (.congruenceFunction argument equal)

/-- (8) along a spine: (M + N) P⃗ = M P⃗ + N P⃗. -/
theorem choiceApplyAll {hypotheses : Term → Term → Prop} :
    ∀ (arguments : List Term) (left right : Term),
      DerivableLatticeEta hypotheses (applyAll (.choice left right) arguments)
        (.choice (applyAll left arguments) (applyAll right arguments))
  | [], _, _ => .reflexive _
  | argument :: rest, left, right =>
      .transitive (congruenceApplyAll rest (.choiceFunctionDistributive left right argument))
        (choiceApplyAll rest _ _)

/-- (9) along a spine: (M ∥ N) P⃗ = M P⃗ ∥ N P⃗. -/
theorem parallelApplyAll {hypotheses : Term → Term → Prop} :
    ∀ (arguments : List Term) (left right : Term),
      DerivableLatticeEta hypotheses (applyAll (.parallel left right) arguments)
        (.parallel (applyAll left arguments) (applyAll right arguments))
  | [], _, _ => .reflexive _
  | argument :: rest, left, right =>
      .transitive (congruenceApplyAll rest (.parallelFunctionDistributive left right argument))
        (parallelApplyAll rest _ _)

/-- Monotonicity in the function position, from (10) and β: from A + B = B, A P + B P = B P. -/
theorem functionMonotone {hypotheses : Term → Term → Prop} {smaller larger : Term} (argument : Term)
    (refines : DerivableLatticeEta hypotheses (.choice smaller larger) larger) :
    DerivableLatticeEta hypotheses
      (.choice (.application smaller argument) (.application larger argument))
      (.application larger argument) :=
  .transitive (.symmetric (.choiceFunctionDistributive _ _ _)) (.congruenceFunction argument refines)

/-- Monotonicity in the argument position, (10): from A + B = B, M A + M B = M B. -/
theorem argumentMonotoneOfRefines {hypotheses : Term → Term → Prop} (function : Term)
    {smaller larger : Term}
    (refines : DerivableLatticeEta hypotheses (.choice smaller larger) larger) :
    DerivableLatticeEta hypotheses
      (.choice (.application function smaller) (.application function larger))
      (.application function larger) :=
  .transitive
    (.congruenceChoiceRight _ (.congruenceArgument function (.symmetric refines)))
    (.transitive (.argumentMonotone function _ _) (.congruenceArgument function refines))

/-- Section 6's lemma (vii) in ⊢_{λ-lattice-η}: from c + a = a and c + b = b, c + (a ∥ b) = a ∥ b. -/
theorem refinesParallel {hypotheses : Term → Term → Prop} {lower first second : Term}
    (firstRefined : DerivableLatticeEta hypotheses (.choice lower first) first)
    (secondRefined : DerivableLatticeEta hypotheses (.choice lower second) second) :
    DerivableLatticeEta hypotheses (.choice lower (.parallel first second)) (.parallel first second) :=
  DerivableLatticeEta.ofDerivableFrom (FourEquations.DerivableFrom.refinesParallel
    DerivableLatticeEta.equationFive DerivableLatticeEta.equationTen (.law firstRefined)
    (.law secondRefined))

/-! ## Ξ unfolds to Ŝ ∥ (K ∥ Ξ Ξ) -/

/-- Y F = F (Y F) for a closed F, by the β rule: both sides are equal to (λx. F (x x)) (λx. F (x x)). -/
theorem fixedPointUnfold {hypotheses : Term → Term → Prop} {functional : Term}
    (closed : Closed functional) :
    DerivableLatticeEta hypotheses (.application fixedPointCombinator functional)
      (.application functional (.application fixedPointCombinator functional)) := by
  have toSelf : DerivableLatticeEta hypotheses (.application fixedPointCombinator functional)
      (selfApplicationFixedPoint functional) := by
    have contractum : instantiate (.application
        (.abstraction (.application (.boundVariable 1)
          (.application (.boundVariable 0) (.boundVariable 0))))
        (.abstraction (.application (.boundVariable 1)
          (.application (.boundVariable 0) (.boundVariable 0))))) functional =
        selfApplicationFixedPoint functional := by
      simp [instantiate, substitute, shiftClosed closed, selfApplicationFixedPoint, selfApplicationOf]
    rw [← contractum]
    exact .beta _ _
  have selfStep : DerivableLatticeEta hypotheses (selfApplicationFixedPoint functional)
      (.application functional (selfApplicationFixedPoint functional)) := by
    have contractum : instantiate
        (.application functional (.application (.boundVariable 0) (.boundVariable 0)))
        (selfApplicationOf functional) =
        .application functional (selfApplicationFixedPoint functional) := by
      simp [instantiate, substitute, substituteClosed closed, selfApplicationFixedPoint]
    rw [← contractum]
    exact .beta _ _
  exact .transitive toSelf (.transitive selfStep (.congruenceArgument _ (.symmetric toSelf)))

/-- Ξ = Ŝ ∥ (K ∥ Ξ Ξ), by the β rule. -/
theorem xiUnfold {hypotheses : Term → Term → Prop} :
    DerivableLatticeEta hypotheses fixedPointOfXi
      (.parallel starling (.parallel first (.application fixedPointOfXi fixedPointOfXi))) := by
  have contractum : instantiate
      (.parallel starling (.parallel first (.application (.boundVariable 0) (.boundVariable 0))))
      fixedPointOfXi =
      .parallel starling (.parallel first (.application fixedPointOfXi fixedPointOfXi)) := by
    simp [instantiate, substitute, substituteClosed closedStarling, substituteClosed closedFirst]
  have step : DerivableLatticeEta hypotheses (.application functionalOfXi fixedPointOfXi)
      (.parallel starling (.parallel first (.application fixedPointOfXi fixedPointOfXi))) := by
    rw [← contractum]
    exact .beta _ _
  exact .transitive (fixedPointUnfold closedFunctionalOfXi) step

/-- Ξ refines Ŝ: Ξ + Ŝ = Ŝ (theorem two, step 1). -/
theorem xiRefinesStarling {hypotheses : Term → Term → Prop} :
    DerivableLatticeEta hypotheses (.choice fixedPointOfXi starling) starling :=
  .transitive (.congruenceChoiceLeft _ xiUnfold) (DerivableLatticeEta.parallelRefinesLeft _ _)

/-- Ξ refines K (theorem two, step 1). -/
theorem xiRefinesFirst {hypotheses : Term → Term → Prop} :
    DerivableLatticeEta hypotheses (.choice fixedPointOfXi first) first :=
  .transitive (.congruenceChoiceLeft _ xiUnfold)
    (DerivableLatticeEta.refinesTransitive (DerivableLatticeEta.parallelRefinesRight _ _)
      (DerivableLatticeEta.parallelRefinesLeft _ _))

/-- Ξ refines Ξ Ξ (theorem two, step 1). -/
theorem xiRefinesSelfApplication {hypotheses : Term → Term → Prop} :
    DerivableLatticeEta hypotheses (.choice fixedPointOfXi (.application fixedPointOfXi fixedPointOfXi))
      (.application fixedPointOfXi fixedPointOfXi) :=
  .transitive (.congruenceChoiceLeft _ xiUnfold)
    (DerivableLatticeEta.refinesTransitive (DerivableLatticeEta.parallelRefinesRight _ _)
      (DerivableLatticeEta.parallelRefinesRight _ _))

/-! ## The terms generated by Ŝ and K (theorem two, step 2) -/

/-- The proofs file's 𝒞: the closed terms generated from Ŝ and K by application, ∥ and +. -/
inductive Combinatory : Term → Prop where
  /-- Ŝ. -/
  | starling : Combinatory starling
  /-- K. -/
  | first : Combinatory first
  /-- A₁ A₂. -/
  | application {function argument : Term} :
      Combinatory function → Combinatory argument → Combinatory (.application function argument)
  /-- A₁ + A₂. -/
  | choice {left right : Term} : Combinatory left → Combinatory right → Combinatory (.choice left right)
  /-- A₁ ∥ A₂. -/
  | parallel {left right : Term} :
      Combinatory left → Combinatory right → Combinatory (.parallel left right)

/-- Theorem two, step 2: Ξ refines every member of 𝒞. An application A₁ A₂: Ξ ⊒ Ξ Ξ ⊒ A₁ Ξ ⊒ A₁ A₂,
by (8) and (10); a parallel by lemma (vii); a choice by (2). -/
theorem xiRefinesCombinatory {hypotheses : Term → Term → Prop} {term : Term}
    (combinatory : Combinatory term) :
    DerivableLatticeEta hypotheses (.choice fixedPointOfXi term) term := by
  induction combinatory with
  | starling => exact xiRefinesStarling
  | first => exact xiRefinesFirst
  | application _ _ functionRefined argumentRefined =>
      exact DerivableLatticeEta.refinesTransitive xiRefinesSelfApplication
        (DerivableLatticeEta.refinesTransitive (functionMonotone _ functionRefined)
          (argumentMonotoneOfRefines _ argumentRefined))
  | choice _ _ leftRefined _ =>
      exact .transitive (.symmetric (DerivableLatticeEta.choiceAssociative _ _ _))
        (.congruenceChoiceLeft _ leftRefined)
  | parallel _ _ leftRefined rightRefined => exact refinesParallel leftRefined rightRefined

/-! ## Bracket abstraction (theorem two, step 3) -/

/-- A combination: de Bruijn variables, Ŝ and K under application, ∥ and +, with no abstraction. -/
inductive Combination where
  /-- A variable by its de Bruijn index. -/
  | variable (index : Nat)
  /-- Ŝ. -/
  | starling
  /-- K. -/
  | first
  /-- An application. -/
  | application (function argument : Combination)
  /-- A choice. -/
  | choice (left right : Combination)
  /-- A parallel. -/
  | parallel (left right : Combination)

namespace Combination

/-- The term a combination stands for. -/
def embed : Combination → Term
  | .variable index => .boundVariable index
  | .starling => Semantics.Term.abstraction (.abstraction (.abstraction (.application
      (.application (.boundVariable 2) (.boundVariable 0))
      (.application (.boundVariable 1) (.boundVariable 0)))))
  | .first => Semantics.first
  | .application function argument => .application function.embed argument.embed
  | .choice left right => .choice left.embed right.embed
  | .parallel left right => .parallel left.embed right.embed

theorem embedStarling : embed .starling = ContextualPreorder.starling := rfl

/-- [x]c, the bracket abstraction of index 0: [x]x = Ŝ K K, [x]y = K y with the index lowered,
[x]Ŝ = K Ŝ, [x]K = K K, [x](A B) = Ŝ ([x]A) ([x]B), [x](A ∥ B) = [x]A ∥ [x]B,
[x](A + B) = [x]A + [x]B. -/
def abstract : Combination → Combination
  | .variable 0 => .application (.application .starling .first) .first
  | .variable (index + 1) => .application .first (.variable index)
  | .starling => .application .first .starling
  | .first => .application .first .first
  | .application function argument =>
      .application (.application .starling function.abstract) argument.abstract
  | .choice left right => .choice left.abstract right.abstract
  | .parallel left right => .parallel left.abstract right.abstract

/-- Every variable of the combination is below the bound. -/
def VariableBelow (bound : Nat) : Combination → Prop
  | .variable index => index < bound
  | .starling => True
  | .first => True
  | .application function argument => VariableBelow bound function ∧ VariableBelow bound argument
  | .choice left right => VariableBelow bound left ∧ VariableBelow bound right
  | .parallel left right => VariableBelow bound left ∧ VariableBelow bound right

/-- Abstracting index 0 lowers the bound by one. -/
theorem variableBelowAbstract {bound : Nat} : ∀ {combination : Combination},
    VariableBelow (bound + 1) combination → VariableBelow bound combination.abstract
  | .variable 0, _ => ⟨⟨trivial, trivial⟩, trivial⟩
  | .variable (index + 1), below => ⟨trivial, by simp only [VariableBelow] at below ⊢; omega⟩
  | .starling, _ => ⟨trivial, trivial⟩
  | .first, _ => ⟨trivial, trivial⟩
  | .application _ _, below =>
      ⟨⟨trivial, variableBelowAbstract below.1⟩, variableBelowAbstract below.2⟩
  | .choice _ _, below => ⟨variableBelowAbstract below.1, variableBelowAbstract below.2⟩
  | .parallel _ _, below => ⟨variableBelowAbstract below.1, variableBelowAbstract below.2⟩

/-- A combination with no variable embeds into 𝒞. -/
theorem combinatoryEmbed : ∀ {combination : Combination}, VariableBelow 0 combination →
    Combinatory combination.embed
  | .variable _, below => absurd below (Nat.not_lt_zero _)
  | .starling, _ => .starling
  | .first, _ => .first
  | .application _ _, below => .application (combinatoryEmbed below.1) (combinatoryEmbed below.2)
  | .choice _ _, below => .choice (combinatoryEmbed below.1) (combinatoryEmbed below.2)
  | .parallel _ _, below => .parallel (combinatoryEmbed below.1) (combinatoryEmbed below.2)

end Combination

/-- Ŝ X Y = λz. X z (Y z), by the β rule twice. -/
theorem starlingApply {hypotheses : Term → Term → Prop} (function argument : Term) :
    DerivableLatticeEta hypotheses
      (.application (.application ContextualPreorder.starling function) argument)
      (.abstraction (.application (.application (shift function) (.boundVariable 0))
        (.application (shift argument) (.boundVariable 0)))) := by
  have firstStep : DerivableLatticeEta hypotheses
      (.application ContextualPreorder.starling function)
      (.abstraction (.abstraction (.application
        (.application (shiftTimes 2 function) (.boundVariable 0))
        (.application (.boundVariable 1) (.boundVariable 0))))) := by
    have step := DerivableLatticeEta.beta (hypotheses := hypotheses)
      (.abstraction (.abstraction (.application
        (.application (.boundVariable 2) (.boundVariable 0))
        (.application (.boundVariable 1) (.boundVariable 0))))) function
    simpa [instantiate, substitute, shiftTimes, shift, ContextualPreorder.starling] using step
  have secondStep : DerivableLatticeEta hypotheses
      (.application (.abstraction (.abstraction (.application
        (.application (shiftTimes 2 function) (.boundVariable 0))
        (.application (.boundVariable 1) (.boundVariable 0))))) argument)
      (.abstraction (.application (.application (shift function) (.boundVariable 0))
        (.application (shift argument) (.boundVariable 0)))) := by
    have step := DerivableLatticeEta.beta (hypotheses := hypotheses)
      (.abstraction (.application
        (.application (shiftTimes 2 function) (.boundVariable 0))
        (.application (.boundVariable 1) (.boundVariable 0)))) argument
    have lowered : substitute 1 (shift argument) (shiftTimes 2 function) = shiftTimes 1 function :=
      substituteShiftTimes 1 (shift argument) function
    simp only [instantiate, substitute] at step
    rw [lowered] at step
    simpa [shiftTimes] using step
  exact .transitive (.congruenceFunction argument firstStep) secondStep

/-- K X = λy. X, by the β rule. -/
theorem firstApply {hypotheses : Term → Term → Prop} (value : Term) :
    DerivableLatticeEta hypotheses (.application first value) (.abstraction (shift value)) := by
  have step := DerivableLatticeEta.beta (hypotheses := hypotheses)
    (.abstraction (.boundVariable 1)) value
  simpa [instantiate, substitute, first] using step

/-- (λx. B)↑ applied to index 0 is B: the β step under a binder. -/
theorem betaShiftedAtZero {hypotheses : Term → Term → Prop} (body : Term) :
    DerivableLatticeEta hypotheses (.application (shift (.abstraction body)) (.boundVariable 0)) body :=
  DerivableLatticeEta.ofDerivableFrom (FourEquations.DerivableFrom.betaShiftedAtZero body)

/-- The bracket abstraction is λ: [x]c = λx. c, in ⊢_{λ-lattice-η} (the proofs file, section 3,
theorem two, step 3: the first four cases by the β rule, an application by the β rule through Ŝ,
∥ and + by T8 and T7). -/
theorem embedAbstract {hypotheses : Term → Term → Prop} :
    ∀ combination : Combination,
      DerivableLatticeEta hypotheses combination.abstract.embed (.abstraction combination.embed)
  | .variable 0 => by
      -- Ŝ K K = λz. K z (K z) = λz. z
      have spread := starlingApply (hypotheses := hypotheses) first first
      rw [shiftClosed closedFirst] at spread
      have inner : DerivableLatticeEta hypotheses
          (.application (.application first (.boundVariable 0))
            (.application first (.boundVariable 0))) (.boundVariable 0) := by
        have step := firstApply (hypotheses := hypotheses) (.boundVariable 0)
        have applied := DerivableLatticeEta.beta (hypotheses := hypotheses)
          (shift (.boundVariable 0)) (.application first (.boundVariable 0))
        simp [instantiate, substitute, shift, shiftFrom] at applied
        exact .transitive (.congruenceFunction _ step) (by simpa [shift, shiftFrom] using applied)
      exact .transitive spread (.congruenceAbstraction inner)
  | .variable (index + 1) => by
      have step := firstApply (hypotheses := hypotheses) (.boundVariable index)
      simpa [Combination.abstract, Combination.embed, shift, shiftFrom] using step
  | .starling => by
      have step := firstApply (hypotheses := hypotheses) ContextualPreorder.starling
      rw [shiftClosed closedStarling] at step
      exact step
  | .first => by
      have step := firstApply (hypotheses := hypotheses) first
      rw [shiftClosed closedFirst] at step
      exact step
  | .application function argument => by
      have functionEqual := embedAbstract (hypotheses := hypotheses) function
      have argumentEqual := embedAbstract (hypotheses := hypotheses) argument
      show DerivableLatticeEta hypotheses
        (.application (.application ContextualPreorder.starling function.abstract.embed)
          argument.abstract.embed) _
      refine .transitive (.congruenceFunction _ (.congruenceArgument _ functionEqual))
        (.transitive (.congruenceArgument _ argumentEqual) ?_)
      exact .transitive (starlingApply _ _)
        (.congruenceAbstraction (.transitive (.congruenceFunction _ (betaShiftedAtZero _))
          (.congruenceArgument _ (betaShiftedAtZero _))))
  | .choice left right =>
      .transitive (DerivableLatticeEta.congruenceChoice (embedAbstract left) (embedAbstract right))
        (.symmetric (DerivableLatticeEta.abstractionChoice _ _))
  | .parallel left right =>
      .transitive
        (.transitive (DerivableLatticeEta.congruenceParallelLeft _ (embedAbstract left))
          (DerivableLatticeEta.congruenceParallelRight _ (embedAbstract right)))
        (.symmetric (DerivableLatticeEta.abstractionParallel _ _))

/-- The translation of a term into a combination: abstractions replaced, innermost first, by
bracket abstraction. -/
def translate : Term → Combination
  | .boundVariable index => .variable index
  | .abstraction body => (translate body).abstract
  | .application function argument => .application (translate function) (translate argument)
  | .choice left right => .choice (translate left) (translate right)
  | .parallel left right => .parallel (translate left) (translate right)

/-- A term equals the embedding of its translation, in ⊢_{λ-lattice-η}: each λ is replaced by its
bracket abstraction under ξ (`embedAbstract`). -/
theorem embedTranslate {hypotheses : Term → Term → Prop} :
    ∀ {term : Term}, DerivableLatticeEta hypotheses (translate term).embed term
  | .boundVariable _ => .reflexive _
  | .abstraction body =>
      .transitive (embedAbstract _) (.congruenceAbstraction (embedTranslate (term := body)))
  | .application function argument =>
      .transitive (.congruenceFunction _ (embedTranslate (term := function)))
        (.congruenceArgument _ (embedTranslate (term := argument)))
  | .choice left right =>
      DerivableLatticeEta.congruenceChoice (embedTranslate (term := left))
        (embedTranslate (term := right))
  | .parallel left right =>
      .transitive (DerivableLatticeEta.congruenceParallelLeft _ (embedTranslate (term := left)))
        (DerivableLatticeEta.congruenceParallelRight _ (embedTranslate (term := right)))

/-- The translation of a term with free indices below the bound has its variables below it. -/
theorem variableBelowTranslate : ∀ {term : Term} {bound : Nat}, FreeBelow bound term →
    (translate term).VariableBelow bound
  | .boundVariable index, _, free => free index rfl
  | .abstraction body, bound, free =>
      Combination.variableBelowAbstract (variableBelowTranslate (term := body) (bound := bound + 1)
        fun index occurs => by
          cases index with
          | zero => omega
          | succ index =>
              have := free index occurs
              omega)
  | .application _ _, _, free =>
      ⟨variableBelowTranslate fun index occurs => free index (.inl occurs),
        variableBelowTranslate fun index occurs => free index (.inr occurs)⟩
  | .choice _ _, _, free =>
      ⟨variableBelowTranslate fun index occurs => free index (.inl occurs),
        variableBelowTranslate fun index occurs => free index (.inr occurs)⟩
  | .parallel _ _, _, free =>
      ⟨variableBelowTranslate fun index occurs => free index (.inl occurs),
        variableBelowTranslate fun index occurs => free index (.inr occurs)⟩

/-- The proofs file's theorem two: for every closed M, ⊢_{λ-lattice-η} Ξ + M = M. M equals the
embedding of its translation, which has no variable and so is in 𝒞. -/
theorem xiRefinesClosed {hypotheses : Term → Term → Prop} {term : Term} (closed : Closed term) :
    DerivableLatticeEta hypotheses (.choice fixedPointOfXi term) term := by
  have equal : DerivableLatticeEta hypotheses (translate term).embed term := embedTranslate
  have refined := xiRefinesCombinatory (hypotheses := hypotheses)
    (Combination.combinatoryEmbed (variableBelowTranslate (freeBelowOfClosed closed 0)))
  exact .transitive (.congruenceChoiceRight _ (.symmetric equal)) (.transitive refined equal)

/-! ## Lemma (F): terms that refine every closed term -/

/-- ⊢_{λ-lattice-η} term + M = M for every closed M: `term` refines every closed term. Ξ does
(theorem two), and so does Ξ A⃗ for every A⃗ (lemma (F)). -/
def RefinesClosedTerms (term : Term) : Prop :=
  ∀ other, Closed other → DerivableLatticeEta (fun _ _ => False) (.choice term other) other

/-- Ξ refines every closed term (theorem two). -/
theorem refinesClosedTermsXi : RefinesClosedTerms fixedPointOfXi :=
  fun _ closed => xiRefinesClosed closed

/-- The property is kept by equality. -/
theorem RefinesClosedTerms.ofDerivable {term other : Term}
    (equal : DerivableLatticeEta (fun _ _ => False) term other) (refines : RefinesClosedTerms other) :
    RefinesClosedTerms term :=
  fun target closed => .transitive (.congruenceChoiceLeft _ equal) (refines target closed)

/-- The property is kept by application to any term: from Z + λy. M = λy. M, applied to A, by (8)
and the β rule, Z A + M = M. -/
theorem RefinesClosedTerms.application {term : Term} (refines : RefinesClosedTerms term)
    (argument : Term) : RefinesClosedTerms (.application term argument) := by
  intro other closed
  have constantClosed : Closed (.abstraction (shift other)) := by
    rw [shiftClosed closed]
    intro index occurs
    exact closed (index + 1) occurs
  have applied := functionMonotone argument (refines _ constantClosed)
  have contracted : DerivableLatticeEta (fun _ _ => False)
      (.application (.abstraction (shift other)) argument) other :=
    DerivableLatticeEta.ofDerivableFrom (FourEquations.DerivableFrom.betaConstant other argument)
  exact .transitive (.congruenceChoiceRight _ (.symmetric contracted)) (.transitive applied contracted)

/-- Lemma (F): Z A⃗ refines every closed term when Z does. -/
theorem RefinesClosedTerms.applyAll : ∀ {term : Term}, RefinesClosedTerms term →
    ∀ arguments : List Term, RefinesClosedTerms (ContextualPreorder.applyAll term arguments)
  | _, refines, [] => refines
  | _, refines, argument :: rest => (refines.application argument).applyAll rest

/-- Lemma (F) for Ξ: Ξ A⃗ + M = M for every closed M and every A⃗. -/
theorem refinesClosedTermsApplyAll (arguments : List Term) :
    RefinesClosedTerms (ContextualPreorder.applyAll fixedPointOfXi arguments) :=
  refinesClosedTermsXi.applyAll arguments

/-- The property is kept by a parallel with anything on the right: (Z ∥ X) + Z = Z by lemma (vi),
and lemma (iv). -/
theorem RefinesClosedTerms.parallelLeft {term : Term} (refines : RefinesClosedTerms term)
    (other : Term) : RefinesClosedTerms (.parallel term other) :=
  fun target closed => DerivableLatticeEta.refinesTransitive
    (DerivableLatticeEta.parallelRefinesLeft _ _) (refines target closed)

/-- The property is kept by a parallel with anything on the left, by (3). -/
theorem RefinesClosedTerms.parallelRight {term : Term} (refines : RefinesClosedTerms term)
    (other : Term) : RefinesClosedTerms (.parallel other term) :=
  (refines.parallelLeft other).ofDerivable (.parallelCommutative _ _)

/-- The property is kept by a choice of two such terms: (Z + Z′) + M = Z + (Z′ + M) = Z + M = M. -/
theorem RefinesClosedTerms.choice {left right : Term} (leftRefines : RefinesClosedTerms left)
    (rightRefines : RefinesClosedTerms right) : RefinesClosedTerms (.choice left right) :=
  fun target closed => .transitive (DerivableLatticeEta.choiceAssociative _ _ _)
    (.transitive (.congruenceChoiceRight _ (rightRefines target closed))
      (leftRefines target closed))

/-! ## The last step of the separation -/

theorem closedSecond : Closed second := by
  intro index occurs
  simp only [second, OccursFree] at occurs
  omega

/-- If K + Z = Z is derivable from some hypotheses and Z refines every closed term, then
K = K* is derivable from them. Z + K = K, so K = Z by (1); Z + K* = K*, so K + K* = K*; applied to
x and y, x + y = y, and applied to y and x, y + x = x; so x = y by (1), and λx. λy. x = λx. λy. y
(section 14.3's argument, with Z in the place of 0). -/
theorem inconsistentOfChoiceRefines {hypotheses : Term → Term → Prop} {refining : Term}
    (refines : RefinesClosedTerms refining)
    (firstRefines : DerivableLatticeEta hypotheses (.choice first refining) refining) :
    DerivableLatticeEta hypotheses first second := by
  have lift : ∀ {left right : Term}, DerivableLatticeEta (fun _ _ => False) left right →
      DerivableLatticeEta hypotheses left right :=
    DerivableLatticeEta.weaken (fun _ _ impossible => impossible.elim)
  have refiningFirst := lift (refines first closedFirst)
  have refiningSecond := lift (refines second closedSecond)
  -- K = Z
  have firstEqual : DerivableLatticeEta hypotheses first refining :=
    DerivableLatticeEta.antisymmetric firstRefines refiningFirst
  -- K + K* = K*
  have sumSecond : DerivableLatticeEta hypotheses (.choice first second) second :=
    .transitive (.congruenceChoiceLeft _ firstEqual) refiningSecond
  -- applied to two variables
  have appliedTwice : ∀ outer inner : Nat,
      DerivableLatticeEta hypotheses
        (.choice (.boundVariable (outer + 2 - 2)) (.boundVariable (inner + 2 - 2)))
        (.boundVariable (inner + 2 - 2)) := by
    intro outer inner
    have spread : DerivableLatticeEta hypotheses
        (.application (.application (.choice first second) (.boundVariable outer))
          (.boundVariable inner))
        (.choice (.application (.application first (.boundVariable outer)) (.boundVariable inner))
          (.application (.application second (.boundVariable outer)) (.boundVariable inner))) :=
      .transitive (.congruenceFunction _ (.choiceFunctionDistributive _ _ _))
        (.choiceFunctionDistributive _ _ _)
    have firstContracted : DerivableLatticeEta hypotheses
        (.application (.application first (.boundVariable outer)) (.boundVariable inner))
        (.boundVariable outer) :=
      .transitive (.congruenceFunction _ (.beta _ _)) (by
        have step := DerivableLatticeEta.beta (hypotheses := hypotheses)
          (substitute 1 (shift (.boundVariable outer)) (.boundVariable 1)) (.boundVariable inner)
        simpa [instantiate, substitute, shift, shiftFrom] using step)
    have secondContracted : DerivableLatticeEta hypotheses
        (.application (.application second (.boundVariable outer)) (.boundVariable inner))
        (.boundVariable inner) :=
      .transitive (.congruenceFunction _ (.beta _ _)) (by
        have step := DerivableLatticeEta.beta (hypotheses := hypotheses)
          (substitute 1 (shift (.boundVariable outer)) (.boundVariable 0)) (.boundVariable inner)
        simpa [instantiate, substitute, shift, shiftFrom] using step)
    have applied := congruenceApplyAll [.boundVariable outer, .boundVariable inner] sumSecond
    simp only [ContextualPreorder.applyAll] at applied
    simp only [Nat.add_sub_cancel]
    exact .transitive (.symmetric (DerivableLatticeEta.congruenceChoice firstContracted secondContracted))
      (.transitive (.symmetric spread) (.transitive applied secondContracted))
  have outerInner := appliedTwice 1 0
  have innerOuter := appliedTwice 0 1
  simp only [Nat.add_sub_cancel] at outerInner innerOuter
  -- x = y + x = x + y = y
  have variablesEqual : DerivableLatticeEta hypotheses (.boundVariable 1) (.boundVariable 0) :=
    .transitive (.symmetric innerOuter) (.transitive (.choiceCommutative _ _) outerInner)
  exact .congruenceAbstraction (.congruenceAbstraction variablesEqual)

end LambdaJit.LatticeEta
